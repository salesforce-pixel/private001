<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#1d4e57">
<title>Health Journal — Raj Shekhar</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#f3efe6;
    --surface:#fbfaf5;
    --surface-2:#f7f4ec;
    --ink:#283a31;
    --ink-soft:#5f6f66;
    --ink-faint:#8a978f;
    --primary:#4a6f5d;
    --primary-deep:#36513f;
    --accent:#c07a52;
    --line:rgba(58,84,67,0.12);
    --line-soft:rgba(58,84,67,0.07);
    --good:#3f8a66;
    --good-bg:#e6f0e9;
    --treat:#bd8a36;
    --treat-bg:#f6efdd;
    --watch:#5180a3;
    --watch-bg:#e6eef3;
    --alert:#bf6049;
    --alert-bg:#f6e6e1;
    --radius:18px;
    --shadow:0 1px 2px rgba(40,58,49,.04), 0 8px 24px rgba(40,58,49,.06);
    --shadow-soft:0 1px 2px rgba(40,58,49,.04);
  }
  *{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;}
  html{scroll-behavior:smooth;}
  body{
    font-family:'Hanken Grotesk',system-ui,sans-serif;
    background:var(--bg);
    color:var(--ink);
    line-height:1.55;
    font-size:15px;
    -webkit-font-smoothing:antialiased;
    background-image:radial-gradient(circle at 12% 8%, rgba(74,111,93,.06), transparent 38%),
                     radial-gradient(circle at 88% 92%, rgba(192,122,82,.05), transparent 42%);
    background-attachment:fixed;
    padding-bottom:env(safe-area-inset-bottom);
  }
  .wrap{max-width:680px;margin:0 auto;padding:0 16px 64px;}

  /* ---------- HERO ---------- */
  .hero{
    position:relative;
    margin:0 -16px 0;
    padding:calc(28px + env(safe-area-inset-top)) 24px 30px;
    background:linear-gradient(155deg,#1c4953 0%,#2a626c 58%,#347580 100%);
    color:#f3efe6;
    border-radius:0 0 30px 30px;
    overflow:hidden;
  }
  .hero::after{
    content:"";position:absolute;right:-50px;top:-60px;width:220px;height:220px;
    border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,.10),transparent 70%);
  }
  .hero .eyebrow{font-size:11px;letter-spacing:.22em;text-transform:uppercase;opacity:.72;font-weight:600;}
  .hero h1{font-family:'Newsreader',serif;font-weight:500;font-size:34px;line-height:1.05;margin:6px 0 4px;letter-spacing:-.01em;}
  .hero .sub{opacity:.8;font-size:13.5px;}
  .vitals{display:flex;gap:7px;flex-wrap:wrap;margin-top:18px;position:relative;z-index:1;}
  .chip{
    background:rgba(255,255,255,.14);backdrop-filter:blur(4px);
    border:1px solid rgba(255,255,255,.16);
    padding:6px 12px;border-radius:999px;font-size:12.5px;font-weight:600;
    display:flex;align-items:center;gap:5px;
  }
  .chip small{opacity:.7;font-weight:500;}

  /* ---------- EMERGENCY ---------- */
  .emergency{
    margin-top:-18px;position:relative;z-index:2;
    background:var(--surface);border-radius:var(--radius);
    box-shadow:var(--shadow);padding:14px 16px;
    display:flex;align-items:center;gap:14px;
    border:1px solid var(--line-soft);
  }
  .emergency .icon{
    flex-shrink:0;width:42px;height:42px;border-radius:12px;
    background:var(--alert-bg);color:var(--alert);
    display:grid;place-items:center;
  }
  .emergency .lbl{font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-faint);font-weight:700;}
  .emergency .name{font-weight:700;font-size:16px;color:var(--ink);}
  .emergency .phone{font-weight:700;font-size:15px;color:var(--accent);letter-spacing:.01em;margin-top:1px;}
  .emergency .role{font-size:12px;color:var(--ink-soft);margin-top:2px;}

  /* ---------- NAV ---------- */
  nav{
    position:sticky;top:0;z-index:50;
    margin:18px -16px 0;padding:10px 16px;
    background:rgba(243,239,230,.86);backdrop-filter:blur(12px);
    border-bottom:1px solid var(--line-soft);
  }
  .navscroll{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch;}
  .navscroll::-webkit-scrollbar{display:none;}
  .navscroll a{
    flex-shrink:0;text-decoration:none;color:var(--ink-soft);
    font-size:13px;font-weight:600;padding:7px 14px;border-radius:999px;
    background:var(--surface);border:1px solid var(--line);white-space:nowrap;
    transition:.2s;
  }
  .navscroll a:active{transform:scale(.96);}
  .navscroll a.active{background:var(--primary);color:#fff;border-color:var(--primary);}

  /* ---------- SECTIONS ---------- */
  section{scroll-margin-top:64px;margin-top:30px;}
  .sec-head{display:flex;align-items:baseline;gap:10px;margin:0 4px 14px;}
  .sec-head h2{font-family:'Newsreader',serif;font-weight:500;font-size:21px;letter-spacing:-.01em;color:var(--primary-deep);}
  .sec-head .count{font-size:12px;color:var(--ink-faint);font-weight:600;background:var(--surface-2);padding:2px 9px;border-radius:999px;}

  .card{
    background:var(--surface);border-radius:var(--radius);
    box-shadow:var(--shadow-soft);border:1px solid var(--line-soft);
    margin-bottom:12px;overflow:hidden;
  }
  .card.pad{padding:16px 17px;}

  /* accordion */
  .acc-btn{
    width:100%;border:none;background:none;cursor:pointer;
    display:flex;align-items:center;gap:12px;text-align:left;
    padding:15px 16px;font-family:inherit;color:inherit;
  }
  .acc-btn .num{
    flex-shrink:0;width:26px;height:26px;border-radius:8px;
    background:var(--surface-2);color:var(--primary);
    font-size:12px;font-weight:700;display:grid;place-items:center;
  }
  .acc-btn .ttl{flex:1;font-weight:700;font-size:14.5px;line-height:1.25;}
  .acc-btn .chev{flex-shrink:0;color:var(--ink-faint);transition:transform .3s;}
  .acc-btn[aria-expanded="true"] .chev{transform:rotate(180deg);}
  .acc-body{display:grid;grid-template-rows:0fr;transition:grid-template-rows .32s ease;}
  .acc-body>div{overflow:hidden;}
  .acc-btn[aria-expanded="true"]+.acc-body{grid-template-rows:1fr;}
  .acc-inner{padding:0 16px 16px 54px;font-size:13.5px;color:var(--ink-soft);}
  .acc-inner p{margin-bottom:8px;}
  .acc-inner strong{color:var(--ink);font-weight:700;}
  .acc-inner ul{list-style:none;margin:6px 0;}
  .acc-inner li{position:relative;padding-left:15px;margin-bottom:5px;}
  .acc-inner li::before{content:"";position:absolute;left:0;top:8px;width:5px;height:5px;border-radius:50%;background:var(--primary);opacity:.5;}

  /* badges */
  .badge{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:700;padding:3px 9px;border-radius:999px;white-space:nowrap;letter-spacing:.01em;}
  .badge::before{content:"";width:6px;height:6px;border-radius:50%;background:currentColor;}
  .b-good{background:var(--good-bg);color:var(--good);}
  .b-treat{background:var(--treat-bg);color:var(--treat);}
  .b-watch{background:var(--watch-bg);color:var(--watch);}
  .b-alert{background:var(--alert-bg);color:var(--alert);}

  /* meds */
  .med{padding:14px 16px;border-bottom:1px solid var(--line-soft);}
  .med:last-child{border-bottom:none;}
  .med .top{display:flex;justify-content:space-between;align-items:flex-start;gap:10px;}
  .med .mname{font-weight:700;font-size:14.5px;color:var(--ink);}
  .med .dose{font-size:12.5px;color:var(--primary);font-weight:700;background:var(--surface-2);padding:3px 9px;border-radius:8px;white-space:nowrap;}
  .med .meta{font-size:12.5px;color:var(--ink-soft);margin-top:4px;}
  .med .note{font-size:12px;color:var(--ink-faint);margin-top:6px;font-style:italic;}

  /* schedule */
  .sched{padding:6px 0;}
  .srow{display:flex;gap:13px;padding:11px 17px;align-items:flex-start;}
  .srow:not(:last-child){border-bottom:1px solid var(--line-soft);}
  .stime{flex-shrink:0;width:74px;font-size:12px;font-weight:700;color:var(--primary);padding-top:1px;}
  .sitem{font-size:13.5px;color:var(--ink);font-weight:600;}
  .snote{font-size:12px;color:var(--ink-soft);margin-top:2px;}

  /* labs */
  .labgroup{padding:13px 16px;border-bottom:1px solid var(--line-soft);}
  .labgroup:last-child{border-bottom:none;}
  .labgroup>h4{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-faint);font-weight:700;margin-bottom:9px;}
  .lab{display:grid;grid-template-columns:1fr auto;gap:4px 10px;align-items:center;padding:6px 0;border-top:1px solid var(--line-soft);}
  .lab:first-of-type{border-top:none;}
  .lab .lname{font-size:13.5px;font-weight:600;color:var(--ink);}
  .lab .lref{font-size:11px;color:var(--ink-faint);}
  .lab .lvals{display:flex;align-items:center;gap:7px;justify-self:end;font-variant-numeric:tabular-nums;}
  .lab .old{font-size:12.5px;color:var(--ink-faint);}
  .lab .arr{font-size:11px;color:var(--ink-faint);}
  .lab .new{font-size:14px;font-weight:700;}
  .n-good{color:var(--good);}.n-treat{color:var(--treat);}.n-alert{color:var(--alert);}.n-ink{color:var(--ink);}
  .labkey{display:flex;gap:14px;flex-wrap:wrap;padding:11px 17px;font-size:11px;color:var(--ink-faint);background:var(--surface-2);}
  .labkey span{display:flex;align-items:center;gap:5px;}
  .dot{width:8px;height:8px;border-radius:50%;}

  /* BP */
  .bpgrid{display:grid;grid-template-columns:1fr 1fr;gap:11px;}
  .bpcard{background:var(--surface);border:1px solid var(--line-soft);border-radius:14px;padding:14px;box-shadow:var(--shadow-soft);}
  .bpcard .per{font-size:11px;color:var(--ink-faint);font-weight:700;text-transform:uppercase;letter-spacing:.08em;}
  .bpcard .med-n{font-size:12.5px;color:var(--primary);font-weight:700;margin:4px 0 9px;line-height:1.3;}
  .bpcard .big{font-family:'Newsreader',serif;font-size:27px;font-weight:500;color:var(--ink);line-height:1;}
  .bpcard .big small{font-size:13px;color:var(--ink-faint);font-family:'Hanken Grotesk';}
  .bpcard .det{font-size:11.5px;color:var(--ink-soft);margin-top:7px;}
  .note-line{font-size:12.5px;color:var(--ink-soft);background:var(--surface-2);border-radius:12px;padding:11px 13px;margin-top:11px;}
  .note-line strong{color:var(--ink);}

  /* timeline */
  .timeline{position:relative;padding-left:8px;}
  .tl{position:relative;padding:0 0 4px 26px;}
  .tl::before{content:"";position:absolute;left:5px;top:6px;bottom:-12px;width:2px;background:var(--line);}
  .tl:last-child::before{display:none;}
  .tl .dotmark{position:absolute;left:0;top:5px;width:12px;height:12px;border-radius:50%;background:var(--primary);border:2.5px solid var(--surface);box-shadow:0 0 0 1.5px var(--primary);}
  .tl.alert .dotmark{background:var(--good);box-shadow:0 0 0 1.5px var(--good);}
  .tl .tdate{font-size:11px;color:var(--ink-faint);font-weight:700;letter-spacing:.04em;text-transform:uppercase;}
  .tl .ttitle{font-weight:700;font-size:14px;color:var(--ink);margin:2px 0 4px;}
  .tl .tdesc{font-size:13px;color:var(--ink-soft);margin-bottom:16px;}

  /* providers */
  .prov{padding:14px 16px;border-bottom:1px solid var(--line-soft);}
  .prov:last-child{border-bottom:none;}
  .prov .pn{font-weight:700;font-size:14.5px;color:var(--ink);}
  .prov .ps{font-size:12px;color:var(--primary);font-weight:600;margin-top:1px;}
  .prov .pp{font-size:12.5px;color:var(--ink-soft);margin-top:5px;}
  .prov a{color:var(--accent);text-decoration:none;font-weight:600;}

  /* checklist */
  .check{display:flex;gap:12px;align-items:flex-start;padding:13px 16px;border-bottom:1px solid var(--line-soft);cursor:pointer;}
  .check:last-child{border-bottom:none;}
  .check .box{flex-shrink:0;width:21px;height:21px;border-radius:7px;border:2px solid var(--line);margin-top:1px;display:grid;place-items:center;transition:.2s;}
  .check .box svg{opacity:0;transform:scale(.5);transition:.2s;}
  .check.done .box{background:var(--primary);border-color:var(--primary);}
  .check.done .box svg{opacity:1;transform:scale(1);}
  .check .txt{font-size:13.5px;color:var(--ink);line-height:1.45;transition:.2s;}
  .check.done .txt{color:var(--ink-faint);text-decoration:line-through;}
  .check .txt b{font-weight:700;}

  /* notes / pills inside */
  .notecard{padding:15px 16px;}
  .notecard h4{font-size:12.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--accent);font-weight:700;margin:14px 0 7px;}
  .notecard h4:first-child{margin-top:0;}
  .notecard ul{list-style:none;}
  .notecard li{position:relative;padding-left:16px;margin-bottom:7px;font-size:13.5px;color:var(--ink-soft);line-height:1.5;}
  .notecard li::before{content:"";position:absolute;left:0;top:8px;width:5px;height:5px;border-radius:50%;background:var(--accent);opacity:.55;}
  .notecard li strong{color:var(--ink);font-weight:700;}

  .info-strip{display:flex;flex-wrap:wrap;gap:8px;}
  .info-pill{background:var(--surface-2);border:1px solid var(--line-soft);border-radius:12px;padding:9px 13px;font-size:12.5px;flex:1 1 calc(50% - 4px);min-width:130px;}
  .info-pill .k{font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-faint);font-weight:700;}
  .info-pill .v{font-weight:700;color:var(--ink);margin-top:1px;}

  .allergy-ok{display:flex;align-items:center;gap:11px;padding:15px 16px;}
  .allergy-ok .ic{width:38px;height:38px;border-radius:11px;background:var(--good-bg);color:var(--good);display:grid;place-items:center;flex-shrink:0;}
  .allergy-ok .t{font-weight:700;color:var(--ink);font-size:14px;}
  .allergy-ok .s{font-size:12px;color:var(--ink-soft);}

  footer{margin-top:40px;text-align:center;}
  .disclaimer{font-size:11.5px;color:var(--ink-faint);line-height:1.6;padding:0 12px;}
  .log-toggle{background:none;border:none;color:var(--ink-faint);font-family:inherit;font-size:12px;font-weight:600;cursor:pointer;margin:18px auto 14px;display:flex;align-items:center;gap:6px;padding:8px;}
  .logbody{display:none;text-align:left;}
  .logbody.open{display:block;}
  .logrow{font-size:12px;color:var(--ink-soft);padding:9px 0;border-top:1px solid var(--line-soft);}
  .logrow .ld{font-weight:700;color:var(--ink);font-size:11px;}

  .reveal{opacity:0;transform:translateY(14px);transition:opacity .5s ease,transform .5s ease;}
  .reveal.in{opacity:1;transform:none;}
  @media (prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none;transition:none;}}
</style>
</head>
