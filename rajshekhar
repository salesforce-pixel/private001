<script>
  // Accordion
  document.querySelectorAll('.acc-btn').forEach(function(btn){
    btn.addEventListener('click', function(){
      var open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
    });
  });

  // Checklist (in-memory)
  document.querySelectorAll('#checklist .check').forEach(function(c){
    c.addEventListener('click', function(){ c.classList.toggle('done'); });
  });

  // Maintenance log
  var logBtn = document.getElementById('logBtn');
  var logBody = document.getElementById('logBody');
  logBtn.addEventListener('click', function(){
    logBody.classList.toggle('open');
    logBtn.querySelector('svg').style.transform = logBody.classList.contains('open') ? 'rotate(180deg)' : '';
  });

  // Nav active state on scroll
  var links = Array.from(document.querySelectorAll('#nav a'));
  var sections = links.map(function(l){ return document.querySelector(l.getAttribute('href')); });
  var navEl = document.getElementById('nav');
  function syncNav(){
    var pos = window.scrollY + 110;
    var idx = 0;
    sections.forEach(function(s, i){ if(s && s.offsetTop <= pos) idx = i; });
    links.forEach(function(l,i){ l.classList.toggle('active', i===idx); });
    var act = links[idx];
    if(act){
      var l = act.offsetLeft - navEl.clientWidth/2 + act.clientWidth/2;
      navEl.scrollTo({left:l, behavior:'smooth'});
    }
  }
  window.addEventListener('scroll', function(){ window.requestAnimationFrame(syncNav); }, {passive:true});

  // Reveal on scroll
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target);} });
  }, {threshold:0.06});
  document.querySelectorAll('.reveal').forEach(function(el){ io.observe(el); });
</script>
