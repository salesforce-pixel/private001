  <!-- ALLERGIES + IDENTITY -->
  <section id="overview" class="reveal" style="margin-top:24px;">
    <div class="sec-head"><h2>At a Glance</h2></div>
    <div class="card allergy-ok" style="margin-bottom:12px;">
      <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div>
      <div>
        <div class="t">No known allergies</div>
